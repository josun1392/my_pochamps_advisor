{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Smogon Bridge Damage Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "damage_rolls",
    "damage_min",
    "damage_max",
    "damage_min_pct",
    "damage_max_pct",
    "ko_chance",
    "modifiers",
    "raw_calc_desc"
  ],
  "properties": {
    "schema_version": {"const": "v1"},
    "damage_rolls": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 0}
    },
    "damage_min": {"type": "integer", "minimum": 0},
    "damage_max": {"type": "integer", "minimum": 0},
    "damage_min_pct": {"type": "number", "minimum": 0},
    "damage_max_pct": {"type": "number", "minimum": 0},
    "ko_chance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n_hits", "chance", "description"],
      "properties": {
        "n_hits": {"type": "integer", "minimum": 0},
        "chance": {"type": "number", "minimum": 0, "maximum": 1},
        "description": {"type": "string"}
      }
    },
    "modifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stab",
        "weather",
        "type_effectiveness",
        "burn",
        "screens",
        "item",
        "ability_attacker",
        "ability_defender"
      ],
      "properties": {
        "stab": {"type": "number"},
        "weather": {"type": "number"},
        "type_effectiveness": {"type": "number"},
        "burn": {"type": "number"},
        "screens": {"type": "number"},
        "item": {"type": "number"},
        "ability_attacker": {"type": "number"},
        "ability_defender": {"type": "number"}
      }
    },
    "raw_calc_desc": {"type": "string"}
  }
}
