    "black_sludge": {"tier": 5, "ownership": "pokemon_item_residual", "terminal": "skip_later_same_owner", "provenance": "Pokemon Showdown data/items.ts Black Sludge.onResidualOrder=5,onResidualSubOrder=4"},
